{
  "name": "stash-plugins",
  "version": "1.0.0",
  "description": "Stash plugins for the Stow ecosystem",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node build.js",
    "build:check": "pnpm build && git diff --exit-code -- plugins/stowServerQR/stow-server-qr.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "archiver": "8.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "js-yaml": "5.5.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "qrcode": "1.5.4",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.28.10"
}
